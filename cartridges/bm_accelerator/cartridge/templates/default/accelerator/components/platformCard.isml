<iscomment>Expects: platform, wizardUrl, dataWizardUrl, contentMigrationUrl</iscomment>
<article class="acc-card ${platform.status === 'ready' ? 'acc-card--ready' : 'acc-card--disabled'}${platform.featured ? ' acc-card--featured' : ''}">
    <span class="acc-card__badge acc-card__badge--${platform.status}">
        <isif condition="${platform.status === 'ready'}">
            ${Resource.msg('accelerator.status.ready', 'accelerator', null)}
        <iselse/>
            ${Resource.msg('accelerator.status.soon', 'accelerator', null)}
        </isif>
    </span>
    <div class="acc-card__head">
        <div class="acc-card__icon ${platform.iconClass}" aria-hidden="true"></div>
        <h3 class="acc-card__name">${platform.name}</h3>
    </div>
    <p class="acc-card__tagline">${platform.tagline}</p>
    <p class="acc-card__desc">${platform.description}</p>
    <isif condition="${platform.status === 'ready'}">
        <div class="acc-card__actions">
            <isif condition="${platform.kind == 'cms'}">
                <a class="acc-btn acc-btn--secondary acc-card__cta"
                   href="${pdict.contentMigrationUrl}?platform=${platform.id}">
                    ${Resource.msg('accelerator.card.contentMigration', 'accelerator', null)}
                </a>
                <isif condition="${platform.dataConnected}">
                    <a class="acc-btn acc-btn--ghost acc-card__cta acc-card__logout"
                       href="${platform.logoutUrl}">
                        ${Resource.msg('accelerator.card.logout', 'accelerator', null)}
                    </a>
                <iselse/>
                    <button type="button"
                            class="acc-btn acc-btn--ghost acc-card__cta acc-card__logout"
                            disabled="disabled"
                            title="${Resource.msg('accelerator.card.logout.disabled', 'accelerator', null)}">
                        ${Resource.msg('accelerator.card.logout', 'accelerator', null)}
                    </button>
                </isif>
            <iselse/>
                <a class="acc-btn acc-btn--secondary acc-card__cta"
                   href="${pdict.wizardUrl}?platform=${platform.id}&amp;step=1">
                    ${Resource.msg('accelerator.card.schemaMigration', 'accelerator', null)}
                </a>
                <a class="acc-btn acc-btn--secondary acc-card__cta"
                   href="${pdict.dataWizardUrl}?platform=${platform.id}">
                    ${Resource.msg('accelerator.card.dataMigration', 'accelerator', null)}
                </a>
                <button type="button" class="acc-btn acc-btn--muted acc-card__cta" disabled="disabled">
                    ${Resource.msg('accelerator.card.storefrontMigration', 'accelerator', null)}
                </button>
                <isif condition="${platform.dataConnected}">
                    <a class="acc-btn acc-btn--ghost acc-card__cta acc-card__logout"
                       href="${platform.logoutUrl}">
                        ${Resource.msg('accelerator.card.logout', 'accelerator', null)}
                    </a>
                <iselse/>
                    <button type="button"
                            class="acc-btn acc-btn--ghost acc-card__cta acc-card__logout"
                            disabled="disabled"
                            title="${Resource.msg('accelerator.card.logout.disabled', 'accelerator', null)}">
                        ${Resource.msg('accelerator.card.logout', 'accelerator', null)}
                    </button>
                </isif>
            </isif>
        </div>
    <iselse/>
        <div class="acc-card__actions">
            <button type="button" class="acc-btn acc-btn--muted acc-card__cta" disabled="disabled">
                ${Resource.msg('accelerator.card.comingSoon', 'accelerator', null)}
            </button>
        </div>
    </isif>
</article>
