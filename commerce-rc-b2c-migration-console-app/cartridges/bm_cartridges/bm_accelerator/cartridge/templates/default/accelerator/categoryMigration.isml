<isdecorate template="application/MenuFrame">
<iscontent type="text/html" charset="UTF-8"/>
<link rel="stylesheet" href="${pdict.cssUrl}"/>
<script src="${pdict.attrPreflightJsUrl}"></script>
<style>
.cm-attr-table{width:100%;border-collapse:collapse;font-size:13px;}
.cm-attr-table thead tr{background:#f4f6f9;border-bottom:2px solid #dddbda;}
.cm-attr-table th{padding:9px 14px;text-align:left;font-size:11px;font-weight:700;color:#54698d;text-transform:uppercase;letter-spacing:.5px;white-space:nowrap;}
.cm-attr-table td{padding:9px 14px;border-bottom:1px solid #f0f2f8;color:#3e3e3c;vertical-align:middle;}
.cm-attr-table tbody tr:last-child td{border-bottom:none;}
.cm-attr-table tbody tr:hover{background:#f8f9fb;}
.cm-attr-id-input{background:#eaf0fb;border:1px solid #c8d6f0;border-radius:3px;font-family:monospace;font-size:12px;color:#16325c;font-weight:600;padding:3px 8px;width:190px;outline:none;box-sizing:border-box;}
.cm-attr-id-input:focus{border-color:#0070d2;background:#fff;box-shadow:0 0 0 2px rgba(0,112,210,.15);}
.cm-attr-type-select{font-size:12px;padding:4px 6px;border:1px solid #c8d6f0;border-radius:3px;background:#fff;color:#16325c;min-width:140px;max-width:180px;}
.cm-btn--revert{background:#fff;color:#c62828;border:1px solid #f0b4b4;padding:4px 12px;font-size:12px;font-weight:600;border-radius:4px;cursor:pointer;white-space:nowrap;}
.cm-btn--revert:hover{background:#fdecea;border-color:#c62828;}
</style>
<div class="acc-page">
<div class="acc-shell">
<isinclude template="accelerator/components/header"/>
<isinclude template="accelerator/components/migrationBackLink"/>
<section class="acc-section">
<header class="acc-section__head">
<h2>Category Data Migration - <isif condition="${pdict.platform === 'shopify'}">Shopify<iselseif condition="${pdict.platform === 'sap'}"/>SAP<iselse/>Commercetools</isif> to SFCC</h2>
</header>

<div style="background:#f4f6f9;border:1px solid #dddbda;border-radius:4px;padding:0;margin-bottom:20px;overflow:hidden;">
<div style="font-weight:700;font-size:13px;color:#16325c;padding:12px 20px 0;">Target Storefront Catalog</div>
<div style="display:flex;border-bottom:2px solid #dddbda;margin:8px 0 0;">
<div id="cat-tab-existing" onclick="_APP.setCatalogMode('existing')" style="padding:8px 20px;font-size:13px;font-weight:600;cursor:pointer;color:#0070d2;border-bottom:3px solid #0070d2;margin-bottom:-2px;">Use Existing Catalog</div>
<div id="cat-tab-new" onclick="_APP.setCatalogMode('new')" style="padding:8px 20px;font-size:13px;font-weight:600;cursor:pointer;color:#54698d;border-bottom:3px solid transparent;margin-bottom:-2px;">Create New Catalog</div>
</div>

<div id="cat-panel-existing" style="padding:16px 20px;">
<div style="display:flex;gap:8px;align-items:center;">
<select id="cat-catalog-select" class="acc-form__input" style="width:300px;padding:6px 8px;font-size:13px;border:1px solid #dddbda;border-radius:4px;">
<option value="">-- Select a catalog --</option>
</select>
<button type="button" id="btn-load-catalogs" class="acc-btn acc-btn--ghost" style="white-space:nowrap;font-size:12px;padding:6px 12px;">Load Catalogs</button>
<span id="catalog-load-status" style="font-size:12px;color:#54698d;"></span>
</div>
</div>

<div id="cat-panel-new" style="display:none;padding:16px 20px;">
<div style="display:flex;gap:14px;flex-wrap:wrap;align-items:flex-end;">
<div>
<label for="new-catalog-id" style="display:block;font-weight:600;font-size:12px;margin-bottom:4px;">Catalog ID</label>
<input id="new-catalog-id" type="text" class="acc-form__input" placeholder="e.g. my-storefront-catalog" style="width:220px;padding:6px 10px;font-size:13px;border:1px solid #dddbda;border-radius:4px;"/>
<div id="new-catalog-id-error" style="display:none;color:#c62828;font-size:11px;margin-top:3px;">Catalog ID is required.</div>
</div>
<div>
<label for="new-catalog-name" style="display:block;font-weight:600;font-size:12px;margin-bottom:4px;">Catalog Name</label>
<input id="new-catalog-name" type="text" class="acc-form__input" placeholder="e.g. My Storefront Catalog" style="width:220px;padding:6px 10px;font-size:13px;border:1px solid #dddbda;border-radius:4px;"/>
<div id="new-catalog-name-error" style="display:none;color:#c62828;font-size:11px;margin-top:3px;">Catalog Name is required.</div>
</div>
<span id="new-catalog-status" style="font-size:12px;color:#54698d;align-self:center;"></span>
</div>
<div id="new-catalog-result" style="display:none;background:#e8f5e9;border:1px solid #2e7d32;border-radius:4px;padding:12px 16px;margin-top:12px;">
<div style="font-weight:600;color:#2e7d32;margin-bottom:6px;">Catalog XML generated. <span id="new-catalog-active-label" style="font-size:12px;font-weight:400;color:#1b5e20;"></span></div>
<div style="font-size:12px;color:#54698d;margin-bottom:4px;">File location:</div>
<code id="new-catalog-xml-path" style="background:#e0e5ee;padding:3px 8px;border-radius:3px;font-size:12px;display:block;margin-bottom:10px;word-break:break-all;"></code>
<a id="btn-new-catalog-impex" href="#" class="acc-btn acc-btn--secondary" style="text-decoration:none;font-size:12px;padding:5px 12px;">Open IMPEX Folder</a>
</div>
</div>
</div>

<div style="display:flex;border-bottom:2px solid #dddbda;margin-bottom:24px;flex-wrap:wrap;">
<div id="tab-1" style="padding:10px 20px;font-size:13px;font-weight:600;color:#0070d2;border-bottom:3px solid #0070d2;cursor:pointer;margin-bottom:-2px;">Step 1 - Check Attributes</div>
<div id="tab-2" style="padding:10px 20px;font-size:13px;font-weight:600;color:#54698d;cursor:pointer;margin-bottom:-2px;">Step 2 - Edit Hierarchy</div>
<div id="tab-3" style="padding:10px 20px;font-size:13px;font-weight:600;color:#54698d;cursor:pointer;margin-bottom:-2px;">Step 3 - Export</div>
</div>

<!-- STEP 1 -->
<div id="panel-step1">

<!-- ── Attribute Pre-flight Panel ── -->
<div id="cat-attr-preflight" style="margin:0 0 28px;border:1px solid #dddbda;border-radius:6px;overflow:hidden;">
	<div style="background:#f4f6f9;border-bottom:1px solid #dddbda;padding:11px 20px;display:flex;align-items:center;gap:12px;flex-wrap:wrap;">
		<span style="font-weight:700;font-size:14px;color:#16325c;">Attribute Pre-flight Check</span>
		<isif condition="${pdict.platform === 'shopify'}">
			<button id="cat-check-attrs-btn" type="button" class="acc-btn acc-btn--ghost">Check Shopify Attributes</button>
		<iselseif condition="${pdict.platform === 'sap'}">
			<button id="cat-check-attrs-btn" type="button" class="acc-btn acc-btn--ghost">Check SAP Attributes</button>
		<iselse/>
			<button id="cat-check-attrs-btn" type="button" class="acc-btn acc-btn--ghost">Check CT Attributes</button>
		</isif>
		<span id="cat-attr-check-msg" style="font-size:13px;color:#54698d;font-weight:600;"></span>
	</div>
	<div style="padding:14px 20px;">
		<isif condition="${pdict.platform === 'shopify'}">
			<p style="font-size:13px;color:#54698d;margin:0;">
				Checks curated Shopify field maps and discovered category attributes
				against the SFCC <strong>Category</strong> system object.
				Missing attributes can be created (or renamed) here before the migration runs.
			</p>
		<iselseif condition="${pdict.platform === 'sap'}">
			<p style="font-size:13px;color:#54698d;margin:0;">
				Checks curated SAP Commerce field maps against the SFCC <strong>Category</strong> system object.
				Missing attributes can be created (or renamed) here before the migration runs.
			</p>
		<iselse/>
			<p style="font-size:13px;color:#54698d;margin:0;">
				Scans CT custom-Type field definitions and checks whether matching
				attributes exist on the SFCC <strong>Category</strong> system object.
				Missing attributes can be created here before the migration runs.
			</p>
		</isif>
		<div id="cat-attr-results" style="display:none;margin-top:14px;"></div>
	</div>
</div>


<div class="acc-move-actions">
	<button type="button" id="btn-skip-attrs" class="acc-btn acc-btn--ghost">Skip to Step 2</button>
	<span id="cat-attr-overall" style="margin-left:14px;font-size:13px;color:#54698d;"></span>
</div>

</div>

<!-- STEP 2 -->
<div id="panel-step2" style="display:none;">
<div style="background:#f4f6f9;border:1px solid #dddbda;border-radius:4px;padding:14px 18px;font-size:13px;margin-bottom:16px;">
Step 2 of 3 - Edit Category Hierarchy and Sort Order.
Grab the arrow icon on any row and drag it up or down to reorder or change level.
Drop on top half of a row = place before it at same level.
Drop on bottom half = make it a child of that row.
Drop on the blue zone = make it a root L1 category.
Use the Parent dropdown to change parent directly.
Use the level filter buttons to view categories by level.
Click Save and Apply Changes to confirm.
</div>
<div style="display:flex;align-items:center;gap:10px;flex-wrap:wrap;margin-bottom:12px;">
<input type="text" id="hierarchy-search" placeholder="Search by name or ID" style="width:220px;padding:6px 10px;font-size:13px;border:1px solid #dddbda;border-radius:4px;"/>
<button type="button" id="btn-load-categories" class="acc-btn acc-btn--secondary">Load Categories from <isif condition="${pdict.platform === 'shopify'}">Shopify<iselseif condition="${pdict.platform === 'sap'}"/>SAP<iselse/>CT</isif></button>
<button type="button" id="btn-reset-hierarchy" class="acc-btn acc-btn--ghost">Reset All</button>
<button type="button" id="btn-save-hierarchy" class="acc-btn acc-btn--primary">Save and Apply Changes</button>
<span style="border-left:1px solid #dddbda;height:24px;display:inline-block;vertical-align:middle;"></span>
<span style="font-size:12px;color:#54698d;font-weight:600;">Export:</span>
<isif condition="${pdict.platform === 'shopify'}"><button type="button" id="btn-select-all-export" class="acc-btn acc-btn--ghost" style="font-size:12px;padding:4px 10px;" title="Select categories that have products assigned">&#10003; With Products</button></isif>
<button type="button" id="btn-select-all-export-all" class="acc-btn acc-btn--ghost" style="font-size:12px;padding:4px 10px;" title="Select all categories">&#10003; All</button>
<button type="button" id="btn-deselect-all-export" class="acc-btn acc-btn--ghost" style="font-size:12px;padding:4px 10px;" title="Uncheck all export checkboxes">&#10007; None</button>
<span id="hierarchy-fetch-status" style="font-size:13px;color:#54698d;"></span>
</div>
<div style="display:flex;align-items:flex-end;gap:10px;flex-wrap:wrap;margin-bottom:12px;padding:12px 14px;background:#f4f6f9;border:1px solid #dddbda;border-radius:4px;">
<div>
<label for="ct-new-cat-key" style="display:block;font-size:12px;font-weight:600;margin-bottom:4px;">Category Key</label>
<input id="ct-new-cat-key" type="text" placeholder="e.g. new-bedding" style="padding:6px 8px;font-size:13px;border:1px solid #dddbda;border-radius:4px;width:160px;"/>
</div>
<div>
<label for="ct-new-cat-name" style="display:block;font-size:12px;font-weight:600;margin-bottom:4px;">Display Name</label>
<input id="ct-new-cat-name" type="text" placeholder="e.g. Bedding" style="padding:6px 8px;font-size:13px;border:1px solid #dddbda;border-radius:4px;width:160px;"/>
</div>
<div>
<label for="ct-new-cat-parent" style="display:block;font-size:12px;font-weight:600;margin-bottom:4px;">Parent Category (optional)</label>
<select id="ct-new-cat-parent" style="padding:6px 8px;font-size:13px;border:1px solid #dddbda;border-radius:4px;width:200px;">
<option value="">-- Root (no parent) --</option>
</select>
</div>
<button type="button" id="btn-create-ct-category" class="acc-btn acc-btn--primary" style="white-space:nowrap;">Add to List</button>
<span id="ct-new-cat-status" style="font-size:12px;color:#54698d;"></span>
</div>
<div id="level-filter-tabs" style="display:none;gap:6px;flex-wrap:wrap;margin-bottom:12px;"></div>
<div id="hierarchy-changes-summary" style="display:none;background:#e8f4fd;border:1px solid #0070d2;border-radius:4px;padding:10px 14px;font-size:13px;margin-bottom:10px;color:#0070d2;">
<strong id="hierarchy-changes-count">0</strong> unsaved change(s). Click Save and Apply Changes to confirm.
</div>
<div id="hierarchy-applied-summary" style="display:none;background:#e8f5e9;border:1px solid #2e7d32;border-radius:4px;padding:10px 14px;font-size:13px;margin-bottom:10px;color:#2e7d32;">
<strong id="hierarchy-applied-count">0</strong> change(s) applied and ready for export.
</div>
<div id="root-drop-zone" style="display:none;border:2px dashed #0070d2;border-radius:6px;padding:12px 20px;text-align:center;color:#0070d2;font-size:13px;font-weight:600;margin-bottom:10px;background:#f0f7ff;">
Drop here to make Root (L1) category
</div>
<div style="border:1px solid #dddbda;border-radius:4px;max-height:520px;overflow-y:auto;">
<table style="width:100%;border-collapse:collapse;font-size:13px;">
<thead><tr>
<th style="background:#f4f6f9;padding:8px 10px;text-align:center;border-bottom:2px solid #dddbda;font-weight:600;color:#16325c;font-size:12px;width:32px;"></th>
<th style="background:#f4f6f9;padding:8px 10px;text-align:left;border-bottom:2px solid #dddbda;font-weight:600;color:#16325c;font-size:12px;width:48px;">Level</th>
<th style="background:#f4f6f9;padding:8px 10px;text-align:left;border-bottom:2px solid #dddbda;font-weight:600;color:#16325c;font-size:12px;width:38px;">Pos</th>
<th style="background:#f4f6f9;padding:8px 10px;text-align:left;border-bottom:2px solid #dddbda;font-weight:600;color:#16325c;font-size:12px;">Category ID</th>
<th style="background:#f4f6f9;padding:8px 10px;text-align:left;border-bottom:2px solid #dddbda;font-weight:600;color:#16325c;font-size:12px;">Name</th>
<th style="background:#f4f6f9;padding:8px 10px;text-align:left;border-bottom:2px solid #dddbda;font-weight:600;color:#16325c;font-size:12px;">Parent</th>
<th style="background:#f4f6f9;padding:8px 10px;text-align:center;border-bottom:2px solid #dddbda;font-weight:600;color:#16325c;font-size:12px;width:60px;" title="Check categories to include in XML export">Export</th>
</tr></thead>
<tbody id="main-cat-tbody">
<tr><td colspan="7" style="text-align:center;padding:30px;color:#54698d;">Click Load Categories from <isif condition="${pdict.platform === 'shopify'}">Shopify<iselseif condition="${pdict.platform === 'sap'}"/>SAP<iselse/>CT</isif> to begin.</td></tr>
</tbody>
</table>
</div>
<div class="acc-move-actions" style="margin-top:14px;">
<button type="button" id="btn-back-to-step1" class="acc-btn acc-btn--ghost">Back</button>
<button type="button" id="btn-next-to-step3" class="acc-btn acc-btn--primary" style="margin-left:10px;">Next - Export</button>
</div>
</div>

<!-- STEP 3 -->
<div id="panel-step3" style="display:none;">
<div id="step3-summary" style="background:#f4f6f9;border:1px solid #dddbda;border-radius:4px;padding:14px 18px;font-size:13px;margin-bottom:20px;">Step 3 of 3 - Export. Ready to migrate.</div>
<ul class="acc-phases" id="cat-phase-list" style="display:none;margin-bottom:24px;">
<li class="acc-phases__item acc-phases__item--pending" id="cat-phase-fetch">
<div class="acc-phases__head"><span>Phase 1 - Fetch and Transform Categories</span><span class="acc-phases__status" id="cat-status-fetch">pending</span></div>
<p class="acc-phases__detail" id="cat-detail-fetch"></p>
<div class="acc-progress"><div class="acc-progress__bar" id="cat-bar-fetch" style="width:0%"></div></div>
</li>
<li class="acc-phases__item acc-phases__item--pending" id="cat-phase-import">
<div class="acc-phases__head"><span>Phase 2 - Write XML to IMPEX</span><span class="acc-phases__status" id="cat-status-import">pending</span></div>
<p class="acc-phases__detail" id="cat-detail-import">Waiting for Phase 1</p>
<div class="acc-progress"><div class="acc-progress__bar" id="cat-bar-import" style="width:0%"></div></div>
<div id="cat-xml-controls" style="display:none;margin-top:12px;padding:14px;background:#f4f6f9;border:1px solid #dddbda;border-radius:4px;">
<div style="font-weight:600;color:#16325c;margin-bottom:8px;">XML written to IMPEX successfully.</div>
<div style="font-size:12px;color:#54698d;margin-bottom:6px;">File location:</div>
<code id="cat-xml-path" style="background:#e0e5ee;padding:4px 8px;border-radius:3px;font-size:12px;display:block;margin-bottom:14px;word-break:break-all;"></code>
<div style="display:flex;gap:10px;flex-wrap:wrap;padding-top:12px;border-top:1px solid #dddbda;">
<a id="btn-open-impex" href="#" class="acc-btn acc-btn--secondary" style="text-decoration:none;">Open IMPEX Folder</a>
</div>
<div style="margin-top:12px;font-size:12px;color:#54698d;line-height:1.8;">
Next steps: 1. Click Open IMPEX Folder. 2. Select the file and run the import job via Administration - Site Development - Import and Export.
</div>
</div>
</li>
</ul>
<div id="cat-move-status" style="display:none;padding:12px 16px;border-radius:4px;margin-bottom:16px;font-size:13px;"></div>
<div class="acc-move-actions">
<button type="button" id="btn-back-to-step2" class="acc-btn acc-btn--ghost">Back</button>
<button type="button" id="cat-start-btn" class="acc-btn acc-btn--primary" style="margin-left:10px;">Run Migration</button>
<span id="cat-move-overall" style="margin-left:14px;font-size:13px;color:#54698d;"></span>
</div>
</div>


</section>
</div>

<script>
(function () {
    var PLATFORM_ID      = '${pdict.platform}';
    var CHECK_ATTRS_URL        = '${pdict.checkAttrsUrl}';
    var CREATE_ATTRS_URL       = '${pdict.createAttrsUrl}';
    var CLEAR_ATTR_MAP_URL     = '${pdict.clearAttrMapUrl}';
    var DELETE_ATTR_URL        = '${pdict.deleteAttrUrl}';
    var CATALOG_ID             = '${pdict.catalogId}';

    if (window.AccAttrPreflight && window.AccAttrPreflight.bindClearOnLeave) {
        window.AccAttrPreflight.bindClearOnLeave(CLEAR_ATTR_MAP_URL, 'Accelerator-CategoryMigration');
    }

    function post(url, params, onDone) {
        var req = new XMLHttpRequest();
        req.open('POST', url, true);
        req.setRequestHeader('Content-Type', 'application/x-www-form-urlencoded');
        req.onreadystatechange = function () {
            if (req.readyState !== 4) return;
            var data;
            try { data = JSON.parse(req.responseText); } catch (e) { data = { ok: false, error: 'Parse error' }; }
            onDone(data);
        };
        req.send(params);
    }

    // ════════════════════════════════════════════════════════════════════════
    // ATTRIBUTE PRE-FLIGHT
    // ════════════════════════════════════════════════════════════════════════

    var checkAttrsBtn = document.getElementById('cat-check-attrs-btn');
    var attrCheckMsg  = document.getElementById('cat-attr-check-msg');
    var attrResults   = document.getElementById('cat-attr-results');

    var pendingMissing = [];

    function handleAttrCheckResult(missing, mapped, coveragePending, skipped, suggested, aiMeta) {
        pendingMissing = missing || [];
        mapped = mapped || [];
        coveragePending = coveragePending || [];
        skipped = skipped || [];
        suggested = suggested || [];
        if (window.AccAttrPreflight && window.AccAttrPreflight.renderMissingResults) {
            var parts = [];
            if (mapped.length) parts.push(mapped.length + ' mapped');
            if (suggested.length) parts.push(suggested.length + ' AI suggestions');
            if (pendingMissing.length) parts.push(pendingMissing.length + ' to create');
            if (coveragePending.length) parts.push(coveragePending.length + ' SFCC pending');
            if (skipped.length) parts.push(skipped.length + ' skipped');
            attrCheckMsg.textContent = parts.length ? parts.join(', ') : 'All attributes in sync.';
            attrCheckMsg.style.color = pendingMissing.length ? '#c62828' : '#2e7d32';
            window.AccAttrPreflight.renderMissingResults({
                container:       attrResults,
                mapped:          mapped,
                coveragePending: coveragePending,
                skipped:         skipped,
                suggested:       suggested,
                aiStatus:        (aiMeta && aiMeta.aiStatus) || 'skipped',
                aiMessage:       (aiMeta && aiMeta.aiMessage) || '',
                suggestAttrMapsUrl: (aiMeta && aiMeta.suggestAttrMapsUrl) || '',
                taskName:           (aiMeta && aiMeta.taskName) || '',
                sfccObjectType:     (aiMeta && aiMeta.sfccObjectType) || '',
                sessionSystemMaps: (aiMeta && aiMeta.sessionSystemMaps) || [],
                missing:         pendingMissing,
                ui:              {},
                createAttrsUrl:  CREATE_ATTRS_URL,
                clearAttrMapUrl: CLEAR_ATTR_MAP_URL || '',
                post:            post,
                getPending:      function () { return pendingMissing; }
            });
            return;
        }
        attrResults.innerHTML = '<p style="color:#c62828;font-size:13px;margin:0;">Attribute helper script failed to load.</p>';
        attrResults.style.display = 'block';
    }

    if (checkAttrsBtn) {
        checkAttrsBtn.addEventListener('click', function () {
            checkAttrsBtn.disabled    = true;
            checkAttrsBtn.textContent = 'Checking...';
            attrCheckMsg.textContent  = '';
            attrResults.style.display = 'none';

            post(CHECK_ATTRS_URL, '', function (data) {
                checkAttrsBtn.disabled    = false;
                checkAttrsBtn.textContent = 'Re-check';
                if (!data.ok) {
                    attrCheckMsg.textContent = 'Error: ' + (data.error || 'Check failed');
                    attrCheckMsg.style.color = '#c62828';
                    return;
                }
                handleAttrCheckResult(data.missing || [], data.mapped || [], data.coveragePending || [], data.skipped || [], data.suggested || [], data);
            });
        });
    }

    // ════════════════════════════════════════════════════════════════════════
    // LOAD MAIN CATEGORY MIGRATION APP
    // ════════════════════════════════════════════════════════════════════════

    function initApp() {
        if (typeof _APP !== 'undefined' && typeof _APP.init === 'function') {
            _APP.MIGRATE_URL         = '${pdict.migrateUrl}';
            _APP.FETCH_URL           = '${pdict.fetchUrl}';
            _APP.ATTRS_URL           = '${pdict.checkAttrsUrl}';
            _APP.STATUS_URL          = '${pdict.checkStatusUrl}';
            _APP.IMPEX_PATH          = '${pdict.impexPath}';
            _APP.PLATFORM            = '${pdict.platform}';
            _APP.FETCH_CATALOGS_URL  = '${pdict.fetchCatalogsUrl}';
            _APP.CREATE_CATALOG_URL       = '${pdict.createCatalogUrl}';
            _APP.CREATE_CATEGORY_URL      = '${pdict.createCategoryUrl}';
            _APP.BM_CLIENT_ID             = ('${pdict.bmClientId}'.replace(/a/g,'').length === 0) ? 'aacf8c92-9166-479f-ba97-a7df6360a1ad' : '${pdict.bmClientId}';
            _APP.META_VERSION             = '${pdict.metaVersion}';
            _APP.IMPORT_URL              = '${pdict.importUrl}';
            _APP.CREATE_CT_CATEGORY_URL  = '${pdict.createCtCategoryUrl}';
            _APP.CHECK_PRODUCTS_URL      = '${pdict.checkProductsUrl}';
            _APP.CREATE_ATTRS_URL        = '${pdict.createAttrsUrl}';
            _APP.init();
        } else {
            setTimeout(initApp, 50);
        }
    }
    var jsScript = document.createElement('script');
    jsScript.src = '${pdict.jsUrl}';
    jsScript.onload = function() { initApp(); };
    jsScript.onerror = function() { /* categoryMigration script failed to load */ };
    document.head.appendChild(jsScript);
}());
</script>
</div>
</div>
</isdecorate>

