        <span class="acc-back-nav__sep" aria-hidden="true">|</span>
        <a class="acc-back" href="${pdict.dataWizardSelectUrl}">&larr; ${Resource.msg('accelerator.datawizard.flow.back', 'accelerator', null)}</a>
    </isif>
</div>
