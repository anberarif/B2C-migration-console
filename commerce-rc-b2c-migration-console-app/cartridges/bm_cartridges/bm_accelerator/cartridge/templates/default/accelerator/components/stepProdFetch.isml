<section class="acc-step-panel">
    <h2 class="acc-step-panel__title">
        Step <isprint value="${pdict.currentStep}" formatter="#"/> &mdash; <span class="acc-highlight">Fetch Products</span>
    </h2>
    <p class="acc-step-panel__intro">
        Review what was found in your commercetools project before proceeding.
    </p>

    <isif condition="${pdict.stepContent.error}">
        <div class="acc-callout acc-callout--error" style="margin-bottom:20px;">
            Could not fetch product count: ${pdict.stepContent.error}.
            Go back to Step 1 and verify your credentials.
        </div>
    <iselse/>
        <div style="display:inline-block;background:#f4f6f9;border:1px solid #dddbda;border-radius:6px;padding:20px 32px;margin-bottom:24px;text-align:center;">
            <div style="font-size:36px;font-weight:700;color:#16325c;" id="prod-count-val">
                <isprint value="${pdict.stepContent.total}" formatter="#,###"/>
            </div>
            <div style="font-size:13px;color:#54698d;margin-top:4px;">Total products in CT</div>
        </div>
    </isif>

    <p style="font-size:13px;color:#54698d;margin:0 0 20px;">
        All product records will be fetched from CT in batches of 500, converted to SFCC catalog XML format,
        and uploaded via WebDAV. In the next step you will specify the target SFCC catalog.
    </p>

    <div style="display:flex;align-items:center;gap:12px;">
        <button type="button" id="prod-recount-btn" class="acc-btn acc-btn--ghost">&#8635; Refresh Count</button>
        <span id="prod-recount-status" style="font-size:13px;color:#54698d;"></span>
    </div>
</section>

<script>
(function () {
    var COUNT_URL = '${URLUtils.url("Accelerator-ProductMigrationCount")}';
    var NEXT_URL  = '${pdict.wizardBaseUrl}?step=${pdict.nextStep}';

    var nextBtn = document.getElementById('acc-next-btn');
    if (nextBtn) nextBtn.href = NEXT_URL;

    document.getElementById('prod-recount-btn').addEventListener('click', function () {
        var btn    = this;
        var status = document.getElementById('prod-recount-status');
        var valEl  = document.getElementById('prod-count-val');
        btn.disabled    = true;
        btn.textContent = 'Fetching…';
        status.textContent = '';

        var req = new XMLHttpRequest();
        req.open('POST', COUNT_URL, true);
        req.setRequestHeader('Content-Type', 'application/x-www-form-urlencoded');
        req.onreadystatechange = function () {
            if (req.readyState !== 4) return;
            var data;
            try { data = JSON.parse(req.responseText); } catch (e) { data = { ok: false }; }
            btn.disabled    = false;
            btn.textContent = '↺ Refresh Count';
            if (data.ok) {
                if (valEl) valEl.textContent = data.total.toLocaleString();
                status.textContent = 'Updated';
                status.style.color = '#2e7d32';
            } else {
                status.textContent = 'Error: ' + (data.error || 'Check BM logs');
                status.style.color = '#c62828';
            }
        };
        req.send('');
    });
}());
</script>
