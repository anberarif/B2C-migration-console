<isdecorate template="application/MenuFrame">
<iscontent type="text/html" charset="UTF-8"/>
<link rel="stylesheet" href="${pdict.cssUrl}"/>
<script src="${pdict.attrPreflightJsUrl}"></script>
<style>
        .acc-info-box { background: #f4f6f9; border: 1px solid #dddbda; border-radius: 4px; padding: 16px 20px; font-size: 13px; line-height: 1.6; margin-bottom: 20px; }
        .acc-info-box strong { color: #16325c; }
        .acc-info-box code { background: #e0e5ee; padding: 1px 5px; border-radius: 3px; font-family: monospace; font-size: 12px; }
        .cm-attr-table { width: 100%; border-collapse: collapse; font-size: 13px; }
        .cm-attr-table thead tr { background: #f4f6f9; border-bottom: 2px solid #dddbda; }
        .cm-attr-table th { padding: 9px 14px; text-align: left; font-size: 11px; font-weight: 700; color: #54698d; text-transform: uppercase; letter-spacing: 0.5px; white-space: nowrap; }
        .cm-attr-table td { padding: 9px 14px; border-bottom: 1px solid #f0f2f8; color: #3e3e3c; vertical-align: middle; }
        .cm-attr-id-input { background: #eaf0fb; border: 1px solid #c8d6f0; border-radius: 3px; font-family: monospace; font-size: 12px; color: #16325c; font-weight: 600; padding: 3px 8px; width: 190px; outline: none; box-sizing: border-box; }
        .cm-btn { padding: 7px 16px; font-size: 13px; font-weight: 600; border-radius: 4px; cursor: pointer; border: 1px solid transparent; display: inline-block; line-height: 1.4; white-space: nowrap; }
        .cm-btn--primary { background: #0070d2; color: #fff; border-color: #005fb2; }
        .cm-btn--primary:disabled { background: #97c3ea; border-color: #97c3ea; cursor: default; }
        .ord-details-panel { margin: 0 0 28px; border: 1px solid #dddbda; border-radius: 6px; overflow: hidden; }
        .ord-details-panel__head { background: #f4f6f9; border-bottom: 1px solid #dddbda; padding: 11px 20px; display: flex; align-items: center; gap: 12px; flex-wrap: wrap; }
        .ord-details-panel__body { padding: 14px 20px; }
        .ord-form-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 16px 20px; margin-bottom: 16px; }
        .ord-form-grid label { display: block; font-weight: 600; font-size: 13px; color: #16325c; margin-bottom: 6px; }
        .ord-form-grid select, .ord-form-grid input { width: 100%; max-width: 280px; }
        .acc-order-count__value { font-size: 15px; font-weight: 600; color: #16325c; margin: 0 0 8px; }
        .acc-order-count__value--idle { color: #54698d; font-weight: 400; }
        .acc-order-count__value--loading { color: #0070d2; }
    </style>
<div class="acc-page">
<div class="acc-shell">
    <isinclude template="accelerator/components/header"/>
    <isinclude template="accelerator/components/migrationBackLink"/>
    <section class="acc-section">
        <header class="acc-section__head">
            <h2>${Resource.msg('accelerator.ordermigration.heading', 'accelerator', null)} &mdash; <span class="acc-highlight">${pdict.sourceLabel} &rarr; SFCC</span></h2>
            <p style="font-size:14px;color:#54698d;margin-top:6px;max-width:720px;">
                <isprint value="${pdict.migrationUi.orderIntro}" encoding="off"/>
            </p>
        </header>

        <div id="acc-attr-preflight" style="margin:24px 0 28px;border:1px solid #dddbda;border-radius:6px;overflow:hidden;">
            <script type="application/json" id="acc-migration-ui-data"><isprint value="${pdict.migrationUiJson}" encoding="off"/></script>
            <div style="background:#f4f6f9;border-bottom:1px solid #dddbda;padding:11px 20px;display:flex;align-items:center;gap:12px;flex-wrap:wrap;">
                <span style="font-weight:700;font-size:14px;color:#16325c;">Attribute Pre-flight Check</span>
                <button id="acc-check-attrs-btn" type="button" class="acc-btn acc-btn--ghost">${pdict.migrationUi.attrCheckBtn}</button>
                <span id="acc-attr-check-msg" style="font-size:13px;color:#54698d;font-weight:600;"></span>
            </div>
            <div style="padding:14px 20px;">
                <p style="font-size:13px;color:#54698d;margin:0;">
                    <isprint value="${pdict.migrationUi.orderAttrScan}" encoding="off"/>
                </p>
                <div id="acc-attr-results" style="display:none;margin-top:14px;"></div>
            </div>
        </div>

        <div id="acc-ord-root" class="ord-details-panel"
             data-count-url="<isprint value="${pdict.countUrl}" encoding="htmldoublequote"/>"
             data-export-url="<isprint value="${pdict.exportUrl}" encoding="htmldoublequote"/>"
             data-check-attrs-url="<isprint value="${pdict.checkAttrsUrl}" encoding="htmldoublequote"/>"
             data-create-attrs-url="<isprint value="${pdict.createAttrsUrl}" encoding="htmldoublequote"/>"
             data-clear-attr-map-url="<isprint value="${pdict.clearAttrMapUrl}" encoding="htmldoublequote"/>"
             data-wizard-entry-url="<isprint value="${pdict.dataWizardEntryUrl}" encoding="htmldoublequote"/>"
             data-impex-path="<isprint value="${pdict.impexPath}" encoding="htmldoublequote"/>"
             data-migration-ui="<isprint value="${pdict.migrationUiJson}" encoding="htmldoublequote"/>">
            <div class="ord-details-panel__head">
                <span style="font-weight:700;font-size:14px;color:#16325c;">Export Filters</span>
            </div>
            <div class="ord-details-panel__body">
                <p style="font-size:13px;color:#54698d;margin:0 0 14px;">
                    Set date range and optional filters, then check how many orders match before building the XML.
                </p>
                <div class="ord-form-grid">
                    <div>
                        <label for="acc-ord-years">${Resource.msg('accelerator.ordermigration.years', 'accelerator', null)}</label>
                        <select id="acc-ord-years" class="acc-form__input">
                            <option value="1">1 ${Resource.msg('accelerator.ordermigration.year', 'accelerator', null)}</option>
                            <option value="2">2 ${Resource.msg('accelerator.ordermigration.years.plural', 'accelerator', null)}</option>
                            <option value="3">3 ${Resource.msg('accelerator.ordermigration.years.plural', 'accelerator', null)}</option>
                        </select>
                    </div>
                    <div>
                        <label for="acc-ord-order-state">${pdict.migrationUi.orderStateLabel}</label>
                        <select id="acc-ord-order-state" class="acc-form__input">
                            <isloop items="${pdict.orderStateFilters}" var="filter">
                                <option value="${filter.value}">${filter.label}</option>
                            </isloop>
                        </select>
                    </div>
                    <div>
                        <label for="acc-ord-payment-state">${pdict.migrationUi.paymentStateLabel}</label>
                        <select id="acc-ord-payment-state" class="acc-form__input">
                            <isloop items="${pdict.paymentStateFilters}" var="filter">
                                <option value="${filter.value}">${filter.label}</option>
                            </isloop>
                        </select>
                    </div>
                    <div>
                        <label for="acc-ord-max-count">${Resource.msg('accelerator.ordermigration.maxcount', 'accelerator', null)}</label>
                        <input type="number" id="acc-ord-max-count" class="acc-form__input" min="1"
                               placeholder="${Resource.msg('accelerator.ordermigration.maxcount.placeholder', 'accelerator', null)}"/>
                    </div>
                </div>

                <div class="acc-order-count" id="acc-ord-count" aria-live="polite">
                    <p class="acc-order-count__value acc-order-count__value--idle" id="acc-ord-count-value">${Resource.msg('accelerator.ordermigration.count.prompt', 'accelerator', null)}</p>
                    <p class="acc-order-count__detail" id="acc-ord-count-export" style="display:none;font-size:13px;color:#54698d;margin:0 0 10px;"></p>
                    <button type="button" id="acc-ord-count-btn" class="acc-btn acc-btn--secondary">
                        ${Resource.msg('accelerator.ordermigration.count.button', 'accelerator', null)}
                    </button>
                </div>
            </div>
        </div>

        <div class="acc-info-box">
            <strong>How migration works:</strong><br/>
            <isprint value="${pdict.migrationUi.orderHowWorks}" encoding="off"/>
            <code>/Impex/${pdict.impexPath}/</code>.<br/>
            Then run <strong>Administration &rarr; Site Development &rarr; Import &amp; Export</strong>
            and import the generated order XML.
        </div>

        <ul class="acc-phases" id="full-phase-list" style="display:none;margin-bottom:24px;">
            <li class="acc-phases__item acc-phases__item--pending" id="full-phase-build">
                <div class="acc-phases__head">
                    <span>Phase 1 &mdash; Build order XML</span>
                    <span class="acc-phases__status" id="full-status-build">pending</span>
                </div>
                <p class="acc-phases__detail" id="full-detail-build"></p>
                <div class="acc-progress"><div class="acc-progress__bar" id="full-bar-build" style="width:0%"></div></div>
            </li>
            <li class="acc-phases__item acc-phases__item--pending" id="full-phase-import">
                <div class="acc-phases__head">
                    <span>Phase 2 &mdash; Import in Business Manager</span>
                    <span class="acc-phases__status" id="full-status-import">pending</span>
                </div>
                <p class="acc-phases__detail" id="full-detail-import">Waiting for Phase 1&hellip;</p>
                <div style="margin-top:10px;display:flex;gap:10px;flex-wrap:wrap;">
                    <a href="${pdict.impexUrl}" target="_blank" class="acc-btn acc-btn--ghost" style="text-decoration:none;font-size:13px;display:inline-block;padding:7px 16px;">Open IMPEX</a>
                </div>
            </li>
        </ul>

        <div id="full-move-status" class="acc-callout acc-callout--info" style="display:none;margin-bottom:20px;"></div>
        <div class="acc-move-actions">
            <button type="button" id="full-start-btn" class="acc-btn acc-btn--primary">Start Migration (Build XML)</button>
            <span id="full-move-overall" style="margin-left:14px;font-size:13px;color:#54698d;"></span>
        </div>
    </section>
</div>

<div id="acc-preflight-modal" style="display:none;position:fixed;top:0;left:0;width:100%;height:100%;background:rgba(0,0,0,.5);z-index:9999;align-items:center;justify-content:center;">
    <div style="background:#fff;border-radius:6px;padding:28px 32px;max-width:620px;width:90%;max-height:82vh;overflow-y:auto;box-shadow:0 8px 40px rgba(0,0,0,.3);">
        <h3 style="margin:0 0 6px;color:#16325c;font-size:16px;">${pdict.migrationUi.attrModalTitle}</h3>
        <p style="font-size:13px;color:#54698d;margin:0 0 16px;">Create missing Order attributes now, or skip and migrate without them.</p>
        <div id="acc-modal-attr-list"></div>
        <div style="margin-top:16px;display:flex;gap:12px;justify-content:flex-end;flex-wrap:wrap;">
            <button id="acc-modal-skip" type="button" class="acc-btn acc-btn--ghost">Skip &amp; Migrate</button>
            <button id="acc-modal-create" type="button" class="acc-btn acc-btn--primary">Migrate Anyway</button>
        </div>
    </div>
</div>

<script src="${pdict.orderMigrationJsUrl}"></script>
</div>
</isdecorate>
