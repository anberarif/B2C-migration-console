<isinclude template="accelerator/components/header"/>

<isinclude template="accelerator/components/migrationBackLink"/>

<isif condition="${!empty(pdict.dataType)}">
    <div class="acc-data-context">
        <span class="acc-data-context__label">${Resource.msg('accelerator.datawizard.migrating', 'accelerator', null)}</span>
        <span class="acc-data-context__value">${pdict.dataType.label}</span>
    </div>
</isif>

<isinclude template="accelerator/components/stepper"/>
