{
    "root": true,
    "extends": [
        "airbnb-base/legacy",
        "prettier"
    ],
    "ignorePatterns": [
        "node_modules/",
        "coverage/",
        "dist/",
        "scripts/",
        "commerce-rc-b2c-migration-console-app/storefront-next/",
        "commerce-rc-b2c-migration-console-app/cartridges/bm_cartridges/*/cartridge/static/"
    ],
    "rules": {
        "import/no-unresolved": "off",
        "indent": ["error", 4, { "SwitchCase": 1, "VariableDeclarator": 1 }],
        "func-names": "off",
        "require-jsdoc": "error",
        "valid-jsdoc": ["error", { "preferType": { "Boolean": "boolean", "Number": "number", "object": "Object", "String": "string" }, "requireReturn": false}],
        "vars-on-top": "off",
        "global-require": "off",
        "no-shadow": ["error", { "allow": ["err", "callback"]}],
        "max-len": "off",
        "no-plusplus": "off"
    }
}
